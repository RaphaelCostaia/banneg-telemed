# ===== Servidor =====
PORT=3000

# ===== Asaas (gateway de cobrança) =====
# Sandbox: https://api-sandbox.asaas.com/v3   |  Produção: https://api.asaas.com/v3
# Sincronização automática com o Asaas (polling, em minutos). 0 desliga.
ASAAS_SYNC_MINUTES=5
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Cole aqui a sua chave de API do Asaas (Sandbox). NÃO compartilhe.
ASAAS_API_KEY=
# Token opcional para validar os webhooks (configure o mesmo valor no painel Asaas)
ASAAS_WEBHOOK_TOKEN=

# ===== Portal Telemedicina (TOTVS Protheus PLS - Medicar) =====
PROTHEUS_BASE_URL=https://medicar146708.protheus.cloudtotvs.com.br:1356/rest
PROTHEUS_USER=api.banneghomol
PROTHEUS_PASS=
# Dados do contrato Banneg (homologação)
PROTHEUS_CNPJ_MEDICAR=34471710000111
PROTHEUS_GRUPO_EMPRESA=0004
PROTHEUS_CONTRATO=002326506
PROTHEUS_TENANT_ID=01,006001
# Plano contratado (produto Medicar)
PROTHEUS_BBA_CODPRO=0066
PROTHEUS_BBA_VERSAO=001
# Fallbacks caso a consulta de contrato não retorne (a consulta tem prioridade)
PROTHEUS_BBA_CODINT=0001
PROTHEUS_BBA_CODEMP=0004
PROTHEUS_BBA_CONEMP=000000000002
PROTHEUS_BBA_VERCON=001
PROTHEUS_BBA_SUBCON=002326506
PROTHEUS_BBA_VERSUB=001

# Modo simulação: quando "true", NÃO envia nada ao Protheus (apenas registra o payload).
# Use enquanto testa o fluxo de vendas/cobrança. Coloque "false" para liberar de verdade.
PROTHEUS_DRY_RUN=true

# Bloquear automaticamente no portal quando a cobrança vence (PAYMENT_OVERDUE)
AUTO_BLOQUEAR_VENCIDO=false

# Endpoint de bloqueio/desbloqueio (o desbloqueio usa o MESMO endpoint: reason 000004 + data-1).
PROTHEUS_BLOCK_PATH=/totvsHealthPlans/familyContract/v1/beneficiaries/blockProtocol

# ===== Integração N8N (vendas automáticas via API) =====
# Chave que o N8N envia no header Authorization: Bearer <chave> (ou x-api-key)
INTEGRACAO_API_KEY=
# URL do webhook do N8N que recebe os callbacks (pagamento_confirmado, cadastro_enviado, etc.)
N8N_WEBHOOK_URL=

# ===== Acesso ao sistema (login) =====
# Usuário admin criado na primeira execução. Troque a senha em produção.
ADMIN_USER=admin
ADMIN_PASSWORD=banneg123
